{
  "name": "Bilderrahmen Controller",
  "short_name": "Bilderrahmen",
  "start_url": "status.php",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f4f9",
  "theme_color": "#007bff",
  "icons": [
    {
      "src": "icon.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "status.php",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "upload_image",
          "accept": ["image/jpeg", "image/png", "image/jpg"]
        }
      ]
    }
  }
}
